<!doctype html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>7–14岁儿童肥胖风险识别</title>
  <style>
    *{box-sizing:border-box}html{background:#eef3f7;color:#172533}body{margin:0;font-family:"Microsoft YaHei",Arial,sans-serif}.shell{max-width:1440px;margin:auto;padding:28px}header{display:flex;justify-content:space-between;gap:24px;align-items:flex-start;margin-bottom:24px}h1{font-size:32px;margin:6px 0 8px}h2{font-size:19px;margin:0 0 14px}.eyebrow{color:#147d88;font-weight:700}.layout{display:grid;grid-template-columns:minmax(0,1fr) 390px;gap:22px}.panel,.risk{background:#fff;border:1px solid #d8e2e8;border-radius:18px;padding:22px;box-shadow:0 10px 30px #1730440d}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.field{display:flex;flex-direction:column;gap:7px;font-size:14px}.field input,.field select,.questions select{border:1px solid #cbd8df;border-radius:9px;padding:10px;background:#fff;font-size:15px}details{margin-top:24px;border-top:1px solid #dce5ea;padding-top:16px}summary{font-weight:700;cursor:pointer}.hint{color:#647582;font-size:13px;line-height:1.5}.questions{display:grid;grid-template-columns:1fr 1fr;gap:8px 18px;margin-top:12px}.questions label{display:grid;grid-template-columns:1fr 66px;align-items:center;gap:10px;font-size:14px;line-height:1.45;border-bottom:1px solid #edf1f3;padding:7px 0}.risk{background:#102f46;color:#fff;position:sticky;top:20px}.risk-title{color:#b9d9df}.risk strong{display:block;font-size:58px;margin:20px 0}.bar{height:9px;background:#ffffff22;border-radius:10px;overflow:hidden}.bar i{display:block;height:100%;background:#40d2c8}.risk h2{margin-top:20px}.risk p{color:#d6e4e8;line-height:1.6}.explain{margin-top:18px}.impact{display:flex;justify-content:space-between;gap:15px;border-top:1px solid #e7edef;padding:10px 0;font-size:14px}.up{color:#b33b45}.down{color:#167a69}footer{padding:24px 4px;color:#60717c;font-size:13px}@media(max-width:900px){.layout{grid-template-columns:1fr}.grid{grid-template-columns:1fr 1fr}.risk{position:static}.questions{grid-template-columns:1fr}}@media(max-width:560px){.shell{padding:16px}.grid,.questions{grid-template-columns:1fr}h1{font-size:26px}}
  </style>
</head>
<body><main class="shell"><header><div><p class="eyebrow">16变量精简模型 · 科研风险识别工具</p><h1>7–14岁儿童肥胖风险识别</h1><p>输入5项基础信息和11项通俗症状问卷评分，获得当前肥胖状态的风险识别概率。工具不使用当前身高、体重或BMI。</p></div><div style="font-size:38px;color:#147d88">⚕</div></header><div class="layout"><section class="panel inputs"><h2>基础信息</h2><div class="grid" id="clinical"></div><details open><summary id="summary">通俗症状简化问卷</summary><p class="hint">题目来源于儿童中医体质问卷，采用家长和儿童易理解的日常表述。评分：1从不或没有，2很少，3有时，4经常，5总是。</p><div class="questions" id="questions"></div></details></section><aside><section class="risk"><div class="risk-title">模型估计概率</div><strong id="probability">—</strong><div class="bar"><i id="bar"></i></div></section><section class="panel explain"><h2>个体模型贡献</h2><p class="hint">展示当前预测路径中影响最大的变量；正值推高风险，负值降低风险。</p><div id="impacts"></div></section></aside></div></main>
<script>
let model,answers={};
const clinical=document.getElementById('clinical'),questions=document.getElementById('questions');
const label=n=>n==='sex=0'?'性别：女童':n==='sex=1'?'性别：男童':n==='delivery_mode=0'?'分娩方式：顺产':n==='delivery_mode=1'?'分娩方式：剖宫产':n==='delivery_mode=2'?'分娩方式：助产或其他':(model.labels[n]||n.replace('num__','').replace('cat__',''));
function transform(){const raw=model.num.map((id,i)=>{const v=Number(answers[id]);return Number.isFinite(v)?v:model.num_median[i]});const indicators=model.missing_indices.map(i=>answers[model.num[i]]===''?1:0);const nums=[...raw,...indicators].map((v,i)=>(v-model.scale_mean[i])/model.scale_scale[i]);const cats=[];model.cat.forEach((id,i)=>model.categories[i].forEach(c=>cats.push(String(answers[id]??model.cat_fill[i])===String(c)?1:0)));return [...nums,...cats]}
function score(){const x=transform(),members=model.models||[model],all=members.map(member=>{let margin=Math.log(member.base_score/(1-member.base_score)),contributions={};for(const t of member.trees){let n=0;while(t.left_children[n]!==-1){const f=t.split_indices[n],v=Math.fround(x[f]),th=Math.fround(t.split_conditions[n]),next=v<th?t.left_children[n]:t.right_children[n];contributions[f]=(contributions[f]||0)+(t.base_weights?.[next]||0)-(t.base_weights?.[n]||0);n=next}margin+=t.split_conditions[n]}return{p:1/(1+Math.exp(-margin)),contributions}}),contributions={};all.forEach(r=>Object.entries(r.contributions).forEach(([i,v])=>contributions[i]=(contributions[i]||0)+Number(v)/all.length));return{p:all.reduce((s,r)=>s+r.p,0)/all.length,contributions}}
function update(){const r=score(),p=r.p;document.getElementById('probability').textContent=(p*100).toFixed(1)+'%';document.getElementById('bar').style.width=Math.min(100,p*100)+'%';const names=[...model.num,...model.missing_indices.map(i=>model.num[i]+'缺失'),...model.cat.flatMap((id,i)=>model.categories[i].map(c=>id+'='+c))];const top=Object.entries(r.contributions).map(([i,v])=>({name:names[Number(i)]||'变量'+i,value:v})).sort((a,b)=>Math.abs(b.value)-Math.abs(a.value)).slice(0,8);document.getElementById('impacts').innerHTML=top.map(x=>`<div class="impact"><span>${label(x.name)}</span><b class="${x.value>=0?'up':'down'}">${x.value>=0?'+':''}${x.value.toFixed(3)}</b></div>`).join('')}
function numericField(id,i){answers[id]=Number(model.num_median[i].toFixed(1));const el=document.createElement('label');el.className='field';el.innerHTML=`<span>${label(id)}</span><input type="number" value="${answers[id]}" step="${id.includes('bmi')?'.1':'1'}">`;el.querySelector('input').addEventListener('input',e=>{answers[id]=e.target.value;update()});return el}
function binaryField(id){answers[id]=id==='sex'?1:0;const el=document.createElement('label');el.className='field';const opts=id==='sex'?'<option value="0">女童</option><option value="1">男童</option>':'<option value="0">无</option><option value="1">有</option>';el.innerHTML=`<span>${label(id)}</span><select>${opts}</select>`;el.querySelector('select').value=String(answers[id]);el.querySelector('select').addEventListener('change',e=>{answers[id]=e.target.value;update()});return el}
fetch('./model.json?v=16-variable-20261116',{cache:'no-store'}).then(r=>{if(!r.ok)throw new Error(`模型请求失败：${r.status}`);return r.json()}).then(m=>{model=m;model.num.forEach((id,i)=>{if(!id.startsWith('q'))clinical.appendChild(id==='sex'||id==='black_acanthosis'?binaryField(id):numericField(id,i))});model.cat.forEach((id,i)=>{answers[id]=model.cat_fill[i];const el=document.createElement('label');el.className='field';const opts=model.categories[i].map(c=>`<option value="${c}">${id==='delivery_mode'?({'0':'顺产','1':'剖宫产','2':'助产或其他'}[String(c)]||c):id==='sex'?(String(c)==='1'?'男童':'女童'):c}</option>`).join('');el.innerHTML=`<span>${label(id)}</span><select>${opts}</select>`;el.querySelector('select').value=String(answers[id]);el.querySelector('select').addEventListener('change',e=>{answers[id]=e.target.value;update()});clinical.appendChild(el)});const qs=model.num.filter(id=>id.startsWith('q'));document.getElementById('summary').textContent=`通俗症状简化问卷（${qs.length}项）`;qs.forEach(id=>{answers[id]=1;const el=document.createElement('label');el.innerHTML=`<span>${label(id)}</span><select>${[1,2,3,4,5].map(v=>`<option value="${v}">${v}</option>`).join('')}</select>`;el.querySelector('select').addEventListener('change',e=>{answers[id]=Number(e.target.value);update()});questions.appendChild(el)});update()}).catch(error=>{console.error(error);document.getElementById('probability').textContent='加载失败，请刷新页面'});
</script></body></html>
